# ==========================================================
# TOKENESTATE BACKEND - ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================================

# 1. Server Settings
APP_ENV=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 2. IPFS Decentralized Storage (Pinata)
# Get your free API JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_secret_token_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# 3. AI Vision & Forensics Configuration
# Note: microsoft/dit-base-finetuned-rvlcdip is PUBLIC (No HF_TOKEN required!)
# Optional: Add HF_TOKEN only if you hit anonymous download rate limits on shared Wi-Fi
HF_TOKEN=

# Optional: Free Gemini API Key from https://aistudio.google.com/apikey
# Enables Layer 3B Deep Visual Stamp, Font Alignment & Scanned Deed OCR Forensics
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Polygon Blockchain & Smart Contract Configuration (Amoy Testnet)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
DOCUMENT_REGISTRY_CONTRACT_ADDRESS=0xYourDeployedDocumentRegistryAddressHere
VERIFIER_PRIVATE_KEY=0xYourVerifierWalletPrivateKeyForBackendSigningOptional